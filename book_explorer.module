<?php

/**
 * Implements hook_block_info().
 */
function book_explorer_block_info() {
  $blocks = array();
  $blocks['book_explorer'] = array(
    'info' => t('Book explorer navigation'),
    'cache' => BACKDROP_CACHE_PER_ROLE | BACKDROP_CACHE_PER_PAGE,
  );
  return $blocks;
}

/**
 * Implements hook_block_configure().
 */
function book_explorer_block_configure($delta = '', $settings = array()) {
  $settings += array(
    'book_explorer_book_mode' => 'all pages',
  );
  $options = array(
    'all pages' => t('Show block on all pages'),
    'book pages' => t('Show block only on book pages'),
  );
  $form['book_explorer_book_mode'] = array(
    '#type' => 'radios',
    '#title' => t('Book navigation block display'),
    '#options' => $options,
    '#default_value' => $settings['book_explorer_book_mode'],
    '#description' => t("The <em>Page specific visibility settings</em> or other visibility settings can be used in addition to selectively display this block."),
    );
    $form['book_explorer_book_mode']['all pages']['#description'] = t("The block will contain the automatically generated menus for all of the site's books.");
  $form['book_explorer_book_mode']['book pages']['#description'] = t("The block will contain only the one menu corresponding to the current page's book. If the current page is not in a book, no block will be displayed.");

  return $form;
}

/**
 * Implements hook_block_view().
 */
function book_explorer_block_view($delta = '', $settings = array()) {
  // Only one block
  $block = array();
  $current_bid = 0;
  if ($node = menu_get_object()) {
    $current_bid = empty($node->book['bid']) ? 0 : $node->book['bid'];
  }

  if ($settings['book_explorer_book_mode'] == 'all pages') {
    $block['subject'] = t('Book navigation');
    $book_menus = array();
    foreach (book_get_books() as $book_id => $book) {
      if ($book['bid'] == $current_bid) {
        // If the current page is a node associated with a book, the menu
        // needs to be retrieved.
        $book_menus[$book_id] = menu_tree_output(menu_tree_all_data($node->book['menu_name'] /*, $node->book*/));
      }
      else {
        // Since we know we will only display a link to the top node, there
        // is no reason to run an additional menu tree query for each book.
        $book['in_active_trail'] = FALSE;
        // Check whether user can access the book link.
        $book_node = node_load($book['nid']);
        $book['access'] = node_access('view', $book_node);
        $book_menus[$book_id] = menu_tree_output(menu_tree_all_data($book_node->book['menu_name']));
      }
    }
    $book_menus['#theme'] = 'book_all_books_block';
    $block['content'] = $book_menus;
  }
  elseif ($current_bid) {
    // Only display this block when the user is browsing a book.
    $select = db_select('node', 'n')
    ->fields('n', array('title'))
    ->condition('n.nid', $node->book['bid'])
    ->addTag('node_access');
    $title = $select->execute()->fetchField();
    // Only show the block if the user has view access for the top-level node.
    if ($title) {
      $tree = menu_tree_all_data($node->book['menu_name']);
      // There should only be one element at the top level.
      $data = array_shift($tree);
      $block['subject'] = l($data['link']['link_title'], $data['link']['link_path'], array('attributes' => array('class' => array('book-title'))));
      $block['content'] = ($data['below']) ? menu_tree_output($data['below']) : '';
    }
  }

  if (!empty($block['content'])) {
    // Move block content down one level so we can wrap a div around it
    $block['content'] = array(
      'prefix' => array('#markup' => '<div class="book-explorer">'),
      'build' => $block['content'],
      'suffix' => array('#markup' => '</div>'),
    );

    // Attach css and js which implements the 'explorer' behaviour
    $dir = backdrop_get_path('module', 'book_explorer');
    $block['content']['build']['#attached']['css'] = array($dir . '/css/book_explorer.css');
    $block['content']['build']['#attached']['js'] = array($dir . '/js/book_explorer.js');
  }
  return $block;
}
